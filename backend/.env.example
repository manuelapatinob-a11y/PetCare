# Copia este archivo como "backend/.env" y llena los valores.
# El archivo .env no se sube a GitHub porque tiene contraseñas.

# Base de datos MySQL / MariaDB
MYSQL_DATABASE = petcare
MYSQL_USER = root
MYSQL_PASSWORD =
MYSQL_HOST = localhost
MYSQL_PORT = 3306

PORT = 4000

# Inicio de sesión con Google (Client ID de Google Cloud Console)
GOOGLE_CLIENT_ID =

# Correo para enviar alertas (cuenta de Gmail con "contraseña de aplicación")
SMTP_HOST = smtp.gmail.com
SMTP_PORT = 465
SMTP_USER =
SMTP_PASS =

# Inteligencia artificial gratuita (Groq): clave gratis en https://console.groq.com/keys
GROQ_API_KEY =
